*.md text eol=lf
*.py text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Frozen manifests hash file bytes; keep Git from converting their line endings.
src/** -text
configs/** -text
pyproject.toml -text
requirements.lock.txt -text
# This generated configuration was frozen with CRLF endings.
configs/release.yaml whitespace=cr-at-eol

# Research manifests bind the original external source bytes exactly.
research_snapshot/review_work/** -text
